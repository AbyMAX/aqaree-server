# Copy to .env and fill in (NEVER commit .env)
PORT=8000

# Neon pooled connection string (Connection pooling ON)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Random long string for signing login tokens (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed to call this API (comma-separated for more than one)
FRONTEND_URL=http://localhost:5173

# Google OAuth web client id (same one the app uses)
GOOGLE_CLIENT_ID=936847574905-bmbjqlhbjq3l2mufdgrms56mci3e9iml.apps.googleusercontent.com

# Cloudinary (listing photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (OTP emails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
